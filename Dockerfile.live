FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LIVE_DB_PATH=/data/live_predictions.sqlite3

WORKDIR /app

COPY pyproject.toml requirements-live.txt ./
COPY src ./src
RUN python -m pip install --no-cache-dir -r requirements-live.txt \
    && python -m pip install --no-cache-dir -e .

COPY forward_holdout ./forward_holdout
COPY XAGUSD_H1_5Y_USD_PER_KG_CLEAN.parquet ./XAGUSD_H1_5Y_USD_PER_KG_CLEAN.parquet
COPY live_web ./live_web
COPY run_live.py ./run_live.py

RUN mkdir -p /data && useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app /data
USER appuser

EXPOSE 8000

CMD ["python", "run_live.py"]
