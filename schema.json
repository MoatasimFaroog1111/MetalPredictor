{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Precious Metals Hourly Dataset",
  "description": "Hourly OHLC data for XAU, XAG, XPT, XPD normalized to USD per kilogram.",
  "type": "object",
  "properties": {
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "asset": {"enum": ["XAU", "XAG", "XPT", "XPD"]},
    "source_symbol": {"type": "string"},
    "market_type": {"enum": ["spot_aggregate", "futures_continuous"]},
    "source_provider": {"type": "string"},
    "currency": {"const": "USD"},
    "price_unit": {"const": "USD/kg"},
    "open_usd_per_kg": {"type": ["number", "null"]},
    "high_usd_per_kg": {"type": ["number", "null"]},
    "low_usd_per_kg": {"type": ["number", "null"]},
    "close_usd_per_kg": {"type": ["number", "null"]},
    "open_usd_per_oz": {"type": ["number", "null"]},
    "high_usd_per_oz": {"type": ["number", "null"]},
    "low_usd_per_oz": {"type": ["number", "null"]},
    "close_usd_per_oz": {"type": ["number", "null"]},
    "volume": {"type": ["number", "null"]},
    "quality_flags": {"type": ["string", "null"]}
  },
  "required": [
    "timestamp_utc", "asset", "source_symbol", "market_type",
    "source_provider", "currency", "price_unit"
  ]
}
