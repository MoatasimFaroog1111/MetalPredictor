# Never commit real secrets. Configure these in your deployment secret manager.
LIVE_ADMIN_TOKEN=
LIVE_DB_PATH=runtime/live_predictions.sqlite3

# Optional automatic Silver market source.
# auto prefers Gold API when GOLD_API_KEY is present, then falls back to Twelve Data.
LIVE_MARKET_PROVIDER=auto
GOLD_API_KEY=
GOLD_API_SYMBOL=XAG
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL=XAG/USD
LIVE_AUTO_COLLECT=true
LIVE_COLLECTION_DELAY_MINUTES=5

# BullionVault read-only Bid/Ask + market-depth source for the spread/profit simulator.
# auto = authenticated when BOTH credentials exist; otherwise public cached market view.
# No order-placement or order-cancellation integration exists in MetalPredictor.
BULLIONVAULT_ACCESS_MODE=auto
BULLIONVAULT_USERNAME=
BULLIONVAULT_PASSWORD=
BULLIONVAULT_SECURITY_ID=AGXLN
BULLIONVAULT_CURRENCY=USD
BULLIONVAULT_MARKET_WIDTH=5
BULLIONVAULT_MINIMUM_QUANTITY_KG=0.001
BULLIONVAULT_PUBLIC_FALLBACK=true

# BullionVault microstructure research collector.
# Disabled by default so deploying a new release never starts extra polling implicitly.
# 60 seconds = one view-market request/minute, far below BullionVault's documented limit.
BULLIONVAULT_MICROSTRUCTURE_ENABLED=false
BULLIONVAULT_MICROSTRUCTURE_INTERVAL_SECONDS=60
BULLIONVAULT_MICROSTRUCTURE_DB_PATH=runtime/bullionvault_microstructure.sqlite3

# Confirmed XPT/XPD 62-feature shadow candidate.
# Disabled by default. It records independent forward research evidence only and never
# replaces the frozen live 52-feature model or exposes interim performance scoring.
SHADOW62_ENABLED=false
SHADOW62_DELAY_MINUTES=8
SHADOW62_DB_PATH=runtime/xpt_xpd_shadow62.sqlite3

# Optional Telegram notifications + webhook commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
PUBLIC_BASE_URL=https://your-domain.example

# Runtime network configuration.
HOST=0.0.0.0
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
